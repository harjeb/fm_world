# 复制到项目根目录并重命名为 .env 后填写（.env 已在 .gitignore 中，不要提交）

# Cloudflare Zero Trust → Networks → Tunnels → 你的隧道 → 安装命令里 --token 后面那串
CLOUDFLARE_TUNNEL_TOKEN=

# 服务器 tick 检查间隔（毫秒）。只决定多久检查一次推进，与联赛轮次长度无关：
# 实际节奏由代码常量决定，3 个游戏日一轮，1 游戏日 = 现实 6 小时（即一天 4 个游戏日）。
FM_TICK_MS=30000

# ---- 注册入口 ----
# open   谁都能注册
# invite 必须填邀请码（需同时设置 FM_INVITE_CODE）
# closed 关闭注册，只能登录已有账号
FM_REGISTRATION=open

# FM_REGISTRATION=invite 时必填；没配会自动降级为 closed 并打日志
FM_INVITE_CODE=

# 单 IP 每小时注册次数上限，0 表示不限
FM_REGISTER_LIMIT_PER_HOUR=5

# ---- Cloudflare Turnstile（可选，免费不限量）----
# Cloudflare 后台 → Turnstile → Add widget 拿到的两个值；不配则跳过人机验证
FM_TURNSTILE_SITEKEY=
FM_TURNSTILE_SECRET=

# 容器时区
TZ=Asia/Shanghai
