{
  "name": "fm-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FM 世界 — 阵容培养与七人制足球比赛原型",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/simulate.ts",
    "match:profile": "tsx scripts/count-steps.ts",
    "match:motion": "tsx scripts/motion-profile.ts",
    "match:timing": "tsx scripts/playback-timing.ts",
    "match:tracking": "tsx scripts/export-match-tracking.ts",
    "smoke:animation": "node scripts/match-animation-smoke.mjs",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "smoke": "node scripts/browser-smoke.mjs",
    "balance": "tsx scripts/balance.ts",
    "mcp": "tsx mcp/index.ts",
    "fm:import": "tsx scripts/import-fm.ts",
    "legend:preview": "tsx scripts/legend-preview.ts",
    "traits:gen": "tsx scripts/generate-star-traits.ts",
    "commentary:gen": "tsx scripts/build-commentary.ts",
    "pes:baseline": "tsx scripts/pes-baseline.ts",
    "pes:equiv": "tsx scripts/pes-equivalence.ts",
    "pes:diff": "tsx scripts/pes-diff.ts",
    "pes:freerun": "tsx scripts/pes-freerun.ts",
    "pes:game": "tsx scripts/pes-game.ts",
    "typecheck": "tsc --noEmit",
    "build:site": "vite build",
    "build:safe": "bash scripts/build-safe.sh",
    "pes:stamina": "tsx scripts/pes-stamina.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  }
}
